# ============================================================================
# SZCA — DEV profile (ONNX only, CPU, single user)
# ============================================================================
# Purpose: prove the PIPELINE is correct on a laptop / CPU VM. Not a perf target.
#
#   cp env.dev.example .env.dev && set -a && . ./.env.dev && set +a
#   cargo run --manifest-path szca_media_gateway/Cargo.toml
#
# `.env*` is gitignored; this `.example` is the committed template.
# See PROJECT.md §4 (Deployment Profiles) and §9 (Dev Setup).
# ============================================================================

# ---- ONNX Runtime ---------------------------------------------------------
# The `ort` crate is built with `load-dynamic`, so the dylib must be resolvable.
#   macOS (Homebrew): /opt/homebrew/lib/libonnxruntime.dylib
#   Linux:            /usr/local/lib/libonnxruntime.so
ORT_DYLIB_PATH=/opt/homebrew/lib/libonnxruntime.dylib

# ---- Server --------------------------------------------------------------
SZCA_LISTEN_ADDR=127.0.0.1
SZCA_PORT=3000
RUST_LOG=info

# ---- LLM: in-process ONNX (no GPU, no external server) -------------------
LLM_BACKEND=onnx

# === DEFAULT: Qwen2.5-0.5B-Instruct ONNX ===
# ~350 MB, loads in ~1s, ~30-50 tok/s on CPU. Best for daily dev iteration.
# ChatML prompt format — no code change needed vs prod.
# Download:  ./download_models.sh (default downloads this)
LLM_MODEL_DIR=./models/llm/Qwen2.5-0.5B-Instruct

# === ALTERNATIVE: Hermes-3-Llama-3.2-3B FP32 ===
# Same model family as prod for correctness parity, but ~14.4 GB external data.
# ~40 s load time, single-digit tok/s on CPU. Best for model-family testing.
# Download:  LLM_MODEL=hermes3 ./download_models.sh
#
# Layout in this directory (as produced by ./download_models.sh):
#   model.onnx             graph
#   model.onnx_data        FP32 weights (~14.4 GB, ONNX external data)
#
# One model per directory. Resolution picks the first matching *.onnx in the dir,
# so a dir holding two models would pair one graph with the other's config.json.
# LLM_MODEL_DIR=./models/llm/Hermes-3-Llama-3.2-3B

# Chat template is auto-detected from tokenizer_config.json's `chat_template`.
# Hermes-3 reports model_type "llama" but is ChatML-tuned, so the ARCHITECTURE
# is not a reliable signal. Uncomment only to override the detection.
# LLM_CHAT_TEMPLATE=chatml

# Keep replies short: INT8 1.5B on CPU is ~10-20 tok/s, but 96 is still a good
# cap for quick iteration. Raise once you move to GPU/vLLM.
LLM_MAX_NEW_TOKENS=96

# ---- STT / TTS: in-process ONNX -----------------------------------------
# These two are the built-in defaults, listed only to be explicit — running from
# the repo root works without them. Paths are relative to the CWD, so set them
# when starting the gateway from anywhere other than the repo root.
STT_MODEL_DIR=./models/stt
TTS_MODEL_DIR=./models/tts
TTS_VOICE=af_heart

# ---- STT backend ----------------------------------------------------------
# `parakeet` (default) = full-utterance Parakeet TDT 0.6B: the whole post-VAD
#                        utterance in one shot, full-context Conformer encoder.
# `streaming` / `eou` = cache-aware Parakeet EOU 120M: 1.28 s chunks with the
#                       attention/conv cache carried between them. ~15x RTF.
# `zipformer`         = Sherpa Zipformer: 1.41 s chunks, 19-layer, English-only,
#                        80-mel Kaldi frontend, stateless decoder. ~20x RTF.
# Any other value (including a typo) falls back to `parakeet` — check
# `stt_backend` in GET /health to confirm which one actually loaded.
STT_BACKEND=parakeet
STT_EOU_MODEL_DIR=./models/stt_eou
SHERPA_MODEL_DIR=./models/sherpa_zipformer

# ---- Pools: one replica each (correctness, not density) ------------------
# Each replica is one full model instance on its own OS thread. On CPU with a
# 14 GB FP32 LLM, LLM_REPLICAS>1 will exhaust RAM. Set a stage to 0 to disable
# it entirely (its model never loads) — e.g. STT-only or TTS-only runs.
STT_REPLICAS=1
LLM_REPLICAS=1
TTS_REPLICAS=1

# ---- VAD ------------------------------------------------------------------
# Empty => RMS-energy fallback (deterministic, no weights). Point at the Silero
# ONNX for real VAD once ./download_models.sh has run.
SILERO_VAD_MODEL=
# SILERO_VAD_MODEL=./models/vad/silero_vad.onnx

# ---- Auth -----------------------------------------------------------------
# Unset in dev => HTTP endpoints accept unauthenticated requests. NEVER leave
# this unset on anything reachable from outside localhost.
# SZCA_API_KEY=dev-local-only

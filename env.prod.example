# ============================================================================
# SZCA — PROD profile (vLLM on GPU, enterprise, 1,000+ concurrent sessions)
# ============================================================================
# Configuration for 1,000 concurrent sessions with vLLM on 8× A100-80GB.
# Same binary, same API contract as DEV — only the LLM backend and pool sizing
# change. See PROJECT.md §4 (Deployment Profiles) and §10 (Prod Setup).
#
# Secrets (SZCA_API_KEY, LLM_API_KEY) belong in your secret manager, NOT here.
# This file is a template: `.env*` is gitignored, `.example` is committed.
# ============================================================================

# ---- ONNX Runtime (still used for STT / TTS / VAD) ------------------------
# Must match the ort crate's pinned version: 2.0.0-rc.10 → ONNX Runtime 1.22.x.
# See Cargo.toml for the current pin.
ORT_DYLIB_PATH=/usr/local/lib/libonnxruntime.so

# ---- Server --------------------------------------------------------------
SZCA_LISTEN_ADDR=0.0.0.0
SZCA_PORT=3000
# Admission-control cap. Enforced BEFORE the WS upgrade (excess gets 503).
SZCA_MAX_SESSIONS=1000
RUST_LOG=info,szca_media_gateway=info

# ---- Tokio runtime -------------------------------------------------------
# Number of tokio async worker threads. With 192 vCPUs, 32 is plenty for
# async I/O (epoll scales sub-linearly). Leave the other 160 cores for
# ONNX replica threads and spawn_blocking turn workers.
SZCA_WORKER_THREADS=32
# Max blocking thread pool size. Each turn worker runs in spawn_blocking.
# At 200 active turns × ~500ms = ~100 threads; 256 gives headroom.
SZCA_BLOCKING_THREADS=256

# ---- Queue backlog -------------------------------------------------------
# Max jobs queued per pool before callers get 503. At 1k sessions with ~200
# simultaneous turns, 1024 prevents overflow when STT/TTS waves hit together.
SZCA_QUEUE_BACKLOG=1024

# ---- LLM: external OpenAI-compatible server (vLLM / TGI) -----------------
# The gateway becomes a STREAMING CLIENT (`stream: true` SSE) — it does no token
# generation and loads no LLM weights. That is why LLM_REPLICAS here is a
# CONCURRENT-REQUEST budget, not a count of in-process models.
LLM_BACKEND=vllm

# Point at the load balancer in front of the vLLM workers, not a single worker.
# 8× A100-80GB: each A100 handles ~250 concurrent with Hermes-3-8B FP8.
# vLLM with tensor parallelism across all 8 GPUs handles 1,000 comfortably.
LLM_BASE_URL=http://vllm-lb:8000
# Must match the `--served-model-name` the vLLM workers were started with.
LLM_MODEL=hermes-3-llama-3.1-8b
# LLM_API_KEY=<from-secret-manager>   # matches vLLM's --api-key

# Voice replies are short by design: a shorter cap bounds tail latency and KV
# cache per sequence. Temperature is nonzero for natural-sounding speech.
LLM_MAX_TOKENS=256
LLM_TEMPERATURE=0.7

# ---- STT / TTS: in-process ONNX (they stay local) ------------------------
# Same per-stage layout as dev (models/{stt,tts,vad}), rooted at the deploy path.
# Streaming STT: set STT_BACKEND=zipformer and SHERPA_MODEL_DIR to activate.
STT_BACKEND=parakeet
STT_MODEL_DIR=/opt/szca/models/stt
STT_EOU_MODEL_DIR=/opt/szca/models/stt_eou
SHERPA_MODEL_DIR=/opt/szca/models/sherpa_zipformer
TTS_MODEL_DIR=/opt/szca/models/tts
TTS_VOICE=af_heart

# ---- Pools ---------------------------------------------------------------
# STT: 48 replicas × ~300 MB = ~14.4 GB — handles ~200 turns/s peak.
# TTS: 24 replicas × ~150 MB = ~3.6 GB — handles ~600 sentence/s.
# LLM: with vLLM backend each replica is a cheap HTTP client. 128 gives
#   enough in-flight budget to vLLM without overwhelming the connection pool.
# DeepFilterNet: noise cancellation before VAD; model loads per session.
#
# Capacity is FUNGIBLE: set a stage to 0 to disable it and reallocate.
#   Full S2S:        STT=48  LLM=128 TTS=24   (1k sessions, 8× A100)
#   STT-only fleet:  STT=128 LLM=0   TTS=0
#   TTS-only fleet:  STT=0   LLM=0   TTS=128
STT_REPLICAS=48
LLM_REPLICAS=128
TTS_REPLICAS=24

# ---- VAD ------------------------------------------------------------------
# Real Silero in prod: the RMS fallback mistakes background noise for speech,
# which causes spurious barge-in (the assistant cutting itself off).
SILERO_VAD_MODEL=/opt/szca/models/vad/silero_vad.onnx

# ---- Auth (REQUIRED in prod) ---------------------------------------------
# Enforces bearer-token auth on /v1/* and /metrics. If this is unset the gateway
# logs a loud warning and serves those routes UNAUTHENTICATED.
# SZCA_API_KEY=<from-secret-manager>
